# Copy to .env and fill in for local overrides. All are optional.

# Default account name used when --account is omitted
AUTO_LI_ACCOUNT=demo

# Directory for session files (storage_state JSON per account)
AUTO_LI_SESSIONS_DIR=./sessions

# Directory scanned by `auto-li queue`
AUTO_LI_CONTENT_DIR=./content

# Queue SQLite DB path
AUTO_LI_QUEUE_DB=./sessions/queue.db

# Log level: DEBUG | INFO | WARNING | ERROR
AUTO_LI_LOG_LEVEL=INFO
